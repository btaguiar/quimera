# Quimera — variáveis de ambiente (copie para .env e ajuste)
# Valores validados na Fase 0 contra o projeto quimera-leads (docs/schema.md).

# Projeto GCP que paga as queries e as chamadas de modelo.
GOOGLE_CLOUD_PROJECT=quimera-leads

# OBRIGATÓRIO: basedosdados fica em US. Errar aqui faz toda query falhar.
BQ_LOCATION=US

# Região do Vertex AI.
VERTEX_LOCATION=us-central1

# Modelos — validados na conta em 2026-09-26 (docs/schema.md).
EXTRACT_MODEL=gemini-2.5-flash
# 005 venceu 004 no recall@5 do golden set (0,606 × 0,561). Se trocar o modelo,
# reconstrua o índice: python -m quimera.cnae build --fonte pares.csv
EMBED_MODEL=text-embedding-005

# Teto de bytes por consulta. Referência medida na Fase 0:
#   sem filtro de partição ....... 132 GB  (sempre recusa — correto)
#   com filtro de partição ....... ~1,7 GB por agregado simples
# 5 GiB = 5368709120
MAX_BYTES_BILLED=5368709120

# Vazio = deploy público. 'private' só no ambiente da Turno 24.
DEPLOY_MODE=
